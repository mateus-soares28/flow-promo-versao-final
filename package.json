{
  "name": "flowpromos-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "evolution:setup": "node scripts/setup-evolution.mjs",
    "evolution:up": "docker compose --env-file .env.local -f compose.evolution.yaml up -d --wait --wait-timeout 240",
    "evolution:down": "docker compose --env-file .env.local -f compose.evolution.yaml down",
    "evolution:status": "docker compose --env-file .env.local -f compose.evolution.yaml ps",
    "evolution:logs": "docker compose --env-file .env.local -f compose.evolution.yaml logs --tail=100 api"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.49.8",
    "lucide-react": "0.468.0",
    "next": "14.2.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.21",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
